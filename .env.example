# Lawfirm V0.01 API Keys —— 仅服务端使用，切勿提交进仓库（已加入 .gitignore）
# 复制本文件为 .env 并填入真实 key 后，后端 /api/chat 才会切到真实 AI 解答。
# 来源示例见 D:\Desktop\key.txt

# 主力推理大模型 hy3
HY3_KEY=你的_hy3_key
HY3_BASE=https://tokenhub.tencentmaas.com/v1
HY3_MODEL=Hy3

# 混元多模态视觉（图片/文件识别）
HUNYUAN_KEY=你的_混元视觉_key
HUNYUAN_BASE=https://tokenhub.tencentmaas.com/v1
HUNYUAN_MODEL=hy-vision-2.0-instruct

# 备用模型（hy3 限额/失败时回退）
DEEPSEEK_KEY=你的_deepseek_key
DEEPSEEK_BASE=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 服务端口
PORT=3000
